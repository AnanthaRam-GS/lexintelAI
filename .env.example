# -----------------------------
# LegalAI - Shared Environment
# -----------------------------
# Copy to .env (never commit .env) and fill in the [required] values; see README.md, "Configure".
# Secrets are empty here on purpose. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Application
# [required] development | test | production. There is no default: the backend refuses to start without it.
# Production enables secure cookies, the seed-password check, and refuses console email delivery.
APP_ENV=development
# Loopback by default. A deployment that must accept outside connections sets 0.0.0.0 explicitly (and passes the
# same address to uvicorn --host, which is what binds the socket).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Answer generation provider [required for answers: a key for the provider below]
# Product runtime supports "groq", "gemini", and the OpenAI-compatible profiles "nvidia", "ollama", "deepseek",
# "openrouter" (step 21) and "groq_backup" (step 22; docs/LLM_PROVIDER_CONFIGURATION.md). The frozen Phase-0
# grounded-answer benchmark (backend/scripts/run_grounded_answer_eval_generation.py) always uses
# Gemini directly and does not read this setting.
LEGALAI_LLM_PROVIDER=groq
# Fallback provider, used only when the primary fails as a provider (unavailable, auth, rate limit, timeout). Empty disables it.
# Step 22: groq_backup (a second Groq model with its own rate limits); Gemini answered no step 11-22 live run.
LEGALAI_LLM_FALLBACK_PROVIDER=groq_backup
# Return per-stage timings and the answering backend in query responses (debug only).
LEGALAI_QUERY_DEBUG=false
# Device for the query embedder and reranker: auto (MPS when available, else CPU) | cpu | mps | cuda.
# A failure on MPS/CUDA falls back to CPU with a warning.
LEGALAI_MODEL_DEVICE=auto
# Reranker half precision on MPS/CUDA (ignored on CPU); the query embedder stays fp32. See docs/performance/PERFORMANCE_BASELINE.md.
LEGALAI_RERANKER_FP16=true
# Load the query models and run a tiny inference at startup (/health reports the state).
LEGALAI_MODEL_WARMUP=true
# Seconds a query waits for the local models (one inference at a time) before 503 MODEL_BUSY / MODELS_LOADING.
LEGALAI_INFERENCE_LOCK_TIMEOUT_SECONDS=30
# Product prompt: v3 (v2 plus concision, step 22) or v2. v1 is the frozen evaluation baseline.
LEGALAI_PROMPT_VERSION=v3
# Output token limit sent to every answer provider (includes reasoning/thinking tokens).
LEGALAI_LLM_MAX_OUTPUT_TOKENS=2048
# Groq: reasoning effort for gpt-oss models (low | medium | high).
LEGALAI_GROQ_REASONING_EFFORT=low
# Groq per-request token ceiling = the account's tokens-per-minute limit (8000 on the base Developer plan for gpt-oss-120b).
LEGALAI_GROQ_MAX_REQUEST_TOKENS=8000
LEGALAI_GROQ_TOKEN_ESTIMATE_FACTOR=1.57
# Step 23 pacing (docs/LLM_PROVIDER_CONFIGURATION.md, "Pacing and rate limits"): answers wait in a FIFO queue for
# model capacity, at most LEGALAI_LLM_QUEUE_MAX_WAIT_SECONDS, then MODEL_BUSY with Retry-After. Groq's free-tier
# limits are per model; its rate-limit headers refine these.
LEGALAI_LLM_PACING_ENABLED=true
LEGALAI_LLM_QUEUE_MAX_WAIT_SECONDS=90
LEGALAI_GROQ_TOKENS_PER_MINUTE=8000
LEGALAI_GROQ_REQUESTS_PER_MINUTE=30
# Gemini 3: thinking level (low | medium | high) and request timeout.
LEGALAI_GEMINI_THINKING=low
LEGALAI_GEMINI_TIMEOUT_SECONDS=90

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Per-mode routing (step 22): public answers go to a separate Groq model (its own rate limits); empty uses
# GROQ_MODEL. gpt-oss-20b passed P1 (citations valid) and P3 (no-coverage) with prompt v3.
GROQ_PUBLIC_MODEL=openai/gpt-oss-20b
# The groq_backup fallback: each mode falls back to the other model (professional -> 20b, public -> 120b).
GROQ_BACKUP_MODEL=openai/gpt-oss-20b
GROQ_BACKUP_PUBLIC_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA API catalog (build.nvidia.com), OpenAI-compatible. Model ID verified from GET /v1/models (step 21).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# Output limit for this profile (reasoning models spend part of it thinking); empty: LEGALAI_LLM_MAX_OUTPUT_TOKENS.
NVIDIA_MAX_OUTPUT_TOKENS=16384
NVIDIA_TIMEOUT_SECONDS=120
# Streamed responses (SSE): NVIDIA_TIMEOUT_SECONDS then bounds each read, NVIDIA_STREAM_DEADLINE_SECONDS the whole answer.
NVIDIA_STREAM=false
NVIDIA_STREAM_DEADLINE_SECONDS=300
# How the answer schema is sent: json_schema (response_format) | json_object (schema as a system message) |
# prompt (schema as a system message, no response_format, for servers without constrained decoding).
NVIDIA_STRUCTURED_OUTPUT=json_schema
# Sent as reasoning_effort when set; NVIDIA documents no reasoning parameter for this model, so leave it empty.
NVIDIA_REASONING_EFFORT=
# Per-request token ceiling for the request-size guard; empty: no guard (1M-token context).
NVIDIA_MAX_REQUEST_TOKENS=

# Ollama (local), through its OpenAI-compatible API at <OLLAMA_BASE_URL>/v1. No key. OLLAMA_MODEL is a model
# created with a larger context (see docs/LLM_PROVIDER_CONFIGURATION.md, "Ollama"); OLLAMA_CONTEXT_TOKENS is that
# context (num_ctx), which the size guard keeps prompt + schema + output within.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=legalai-gemma4-12b
OLLAMA_CONTEXT_TOKENS=16384
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_TIMEOUT_SECONDS=300
# prompt: the Homebrew Ollama build's MLX runner has no constrained decoding (HTTP 501 "structured output is
# unavailable" for json_schema); use json_schema with a build/model that supports it.
OLLAMA_STRUCTURED_OUTPUT=prompt
# none turns thinking off for gemma4 (thinking is on by default and would spend the output limit).
OLLAMA_REASONING_EFFORT=none

# Defined for future keys; a profile stays disabled while its key is empty.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Application-level context/token budgeting - applies product-wide, to every
# query path (public/professional, text and PDF), not just PDF uploads. See
# docs/PRODUCT_CONTEXT_BUDGETING.md and docs/PRIVATE_PDF_CONTEXT_BUDGETING.md.
# Deliberately independent of any provider's advertised maximum context - a
# provider or a rate-limited account tier may accept far less in practice
# (this was tuned against a Groq free-tier account that rejected requests
# above roughly 8,000 tokens - well under the model's nominal context).
# Step 22: sized for Groq's 8,000-token per-request limit (gpt-oss-120b, prompt v3): the output reserve is the real
# output limit, and the request-size guard trims the lowest-ranked trusted evidence (never private P# evidence while
# more than one trusted item is left) until prompt x LEGALAI_GROQ_TOKEN_ESTIMATE_FACTOR + output fits. For a provider
# with a large context (e.g. NVIDIA), use 40000 / 16384 / 4000 / 1500 / 10000 / 18000 instead.
# See docs/LLM_PROVIDER_CONFIGURATION.md ("Prompt v3 and the Groq budget").
LEGALAI_PRODUCT_MAX_INPUT_TOKENS=8000
LEGALAI_LLM_RESERVED_OUTPUT_TOKENS=2048
LEGALAI_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=300
PROMPT_OVERHEAD_RESERVE_TOKENS=1500
TRUSTED_EVIDENCE_INPUT_BUDGET_TOKENS=4000
PRIVATE_PDF_INPUT_BUDGET_TOKENS=1500
PRIVATE_PDF_TOP_K=10
PRIVATE_PDF_MAX_CHUNKS_PER_BATCH=8
# Professional brief: maximum characters of a precedent excerpt.
PRECEDENT_EXCERPT_MAX_CHARS=400

# PostgreSQL [required]: postgresql://<user>:<password>@<host>:5432/<database>. There is no default; the
# backend refuses to start without it (outside APP_ENV=test).
DATABASE_URL=
# DB-backed test suites only (not read by the app): a separate database whose name ends in _test.
# TEST_DATABASE_URL=

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=legalai_trusted_judgments_v1

# Indian Kanoon (only for corpus acquisition scripts; see README.md, "Corpus")
INDIAN_KANOON_API_TOKEN=
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org

# Authentication
# [required] (except APP_ENV=test): at least 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
# Auth cookie SameSite (lax | strict | none). Secure is set in production, and always with none.
AUTH_COOKIE_SAMESITE=lax

# Development seed accounts (backend/scripts/seed_users.py). [required] to run the seed script;
# at least 12 characters each. Never used in production (the script refuses APP_ENV=production).
SEED_LAWYER_PASSWORD=
SEED_ADMIN_PASSWORD=

# Login throttling: failures per email and per client IP within the window, then a lockout.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
# Query rate limits: per client IP on /query/public*, per user on /query/professional*.
PUBLIC_QUERY_LIMIT_PER_MINUTE=5
PUBLIC_QUERY_LIMIT_PER_DAY=100
PROFESSIONAL_QUERY_LIMIT_PER_MINUTE=10
PROFESSIONAL_QUERY_LIMIT_PER_DAY=300
# Concurrent LLM generations per process; extra requests wait this long, then get 503 MODEL_BUSY.
LLM_MAX_CONCURRENT_GENERATIONS=4
LLM_GENERATION_WAIT_SECONDS=10
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted. Empty = trust none.
TRUSTED_PROXIES=

# Legal NLP
INLEGALBERT_MODEL_PATH=./models/inlegalbert-finetuned
INLEGALBERT_CLASSIFICATION_THRESHOLD=0.5
LEGAL_NER_ENABLED=false
LEGAL_NER_MODEL=
LEGAL_NER_DEVICE=cpu
LEGAL_NER_MIN_CONFIDENCE=0.7
LEGAL_NER_MODE=deterministic

# Embeddings / Retrieval
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
BGE_M3_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_TOP_K=5

# Uploads
# OCR fallback for scanned PDF pages; needs the tesseract binary (docs/OCR.md).
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=50
OCR_DPI=300
OCR_LANGUAGE=eng
OCR_MAX_PAGES_QUERY=10
OCR_MAX_PAGES_INGESTION=200
OCR_PAGE_TIMEOUT_SECONDS=30
OCR_DOCUMENT_TIMEOUT_SECONDS_QUERY=90
OCR_DOCUMENT_TIMEOUT_SECONDS_INGESTION=1800
OCR_LOW_CONFIDENCE_THRESHOLD=80
# Full path to tesseract if it is not on PATH.
TESSERACT_CMD=
MAX_UPLOAD_SIZE_MB=10
MAX_QUERY_LENGTH=5000
# Private directory for lawyer verification proofs (outside any web root).
VERIFICATION_DOCUMENT_DIR=./data/private/lawyer_verification

# Email verification
# console prints verification codes to the backend log (development only; refused at startup with
# APP_ENV=production); smtp sends them.
EMAIL_DELIVERY_MODE=console
# development/test only: return the verification code in the API response (the E2E tests use it).
EXPOSE_DEV_VERIFICATION_TOKENS=false
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
