# -----------------------------
# LegalAI - Shared Environment
# -----------------------------

# Application
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Local fallback LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/legalai

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=legalai_trusted_judgments_v1

# Indian Kanoon
INDIAN_KANOON_API_TOKEN=
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Legal NLP
INLEGALBERT_MODEL_PATH=./models/inlegalbert-finetuned
INLEGALBERT_CLASSIFICATION_THRESHOLD=0.5

# Embeddings / Retrieval
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
BGE_M3_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# Uploads
MAX_UPLOAD_SIZE_MB=10
MAX_QUERY_LENGTH=5000
