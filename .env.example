# -----------------------------
# LegalAI - Shared Environment
# -----------------------------

# Application
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Answer generation provider
# Product runtime supports "gemini" or "groq". The frozen Phase-0 grounded-answer
# benchmark (backend/scripts/run_grounded_answer_eval_generation.py) always uses
# Gemini directly and does not read this setting.
LEGALAI_LLM_PROVIDER=groq

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local fallback LLM (stubbed - not wired to any live product query path)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Application-level context/token budgeting (see docs/PRIVATE_PDF_CONTEXT_BUDGETING.md).
# Deliberately independent of any provider's advertised maximum context - a
# provider or a rate-limited account tier may accept far less in practice.
# Inspect your actual prompt/schema size and provider/tier before raising these.
LEGALAI_LLM_CONTEXT_TOKENS=40000
LEGALAI_LLM_RESERVED_OUTPUT_TOKENS=6000
LEGALAI_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=4000
PRIVATE_PDF_INPUT_BUDGET_TOKENS=18000
TRUSTED_EVIDENCE_INPUT_BUDGET_TOKENS=10000
PRIVATE_PDF_TOP_K=10
PRIVATE_PDF_MAX_CHUNKS_PER_BATCH=8

# PostgreSQL
# SQLAlchemy accepts this default with the psycopg2-compatible PostgreSQL driver
# declared in requirements.txt.
DATABASE_URL=postgresql://user:password@localhost:5432/legalai

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=legalai_trusted_judgments_v1

# Indian Kanoon
INDIAN_KANOON_API_TOKEN=
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Legal NLP
INLEGALBERT_MODEL_PATH=./models/inlegalbert-finetuned
INLEGALBERT_CLASSIFICATION_THRESHOLD=0.5
LEGAL_NER_ENABLED=false
LEGAL_NER_MODEL=
LEGAL_NER_DEVICE=cpu
LEGAL_NER_MIN_CONFIDENCE=0.7
LEGAL_NER_MODE=deterministic

# Embeddings / Retrieval
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
BGE_M3_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_TOP_K=5

# Uploads
MAX_UPLOAD_SIZE_MB=10
MAX_QUERY_LENGTH=5000

# Email verification
EMAIL_DELIVERY_MODE=console
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
